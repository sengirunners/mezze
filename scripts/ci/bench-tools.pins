# What scripts/ci/bench-tools.sh downloads when a tool is missing (a zm pool box). One line per tool and arch:
# <tool> <uname -m> <url> <sha256 of the download> <path of the binary in it: "." for a bare binary>
# gh 2.103.3 (2026-10-26) and jq 1.8.2 (2026-06-20); sums from each release's checksum file.
gh x86_64 https://github.com/cli/cli/releases/download/v2.103.3/gh_2.103.3_linux_amd64.tar.gz 4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d gh_2.103.3_linux_amd64/bin/gh
gh aarch64 https://github.com/cli/cli/releases/download/v2.103.3/gh_2.103.3_linux_arm64.tar.gz ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63 gh_2.103.3_linux_arm64/bin/gh
jq x86_64 https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-amd64 b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f .
jq aarch64 https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-arm64 8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309 .
